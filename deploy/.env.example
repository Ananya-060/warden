# Generate a long random value, e.g. `openssl rand -base64 48`.
WARDEN_API_KEY=replace-with-a-long-random-secret

# The dashboard will be available on this host port.
WARDEN_PORT=8080

# Leave blank when dashboard and API are served by this Compose stack.
# Set this only when a browser app is hosted on a different origin.
WARDEN_CORS_ORIGIN=
