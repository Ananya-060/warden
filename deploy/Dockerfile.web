FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/cli/package.json apps/cli/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/sdk/package.json packages/sdk/package.json
RUN mkdir -p samples/mcp-filesystem-server samples/mcp-github-server samples/mcp-puppeteer-server samples/mcp-slack-server samples/mcp-sqlite-server \
  packages/sdk-python apps/api-python \
  && echo '{"name":"mcp-filesystem-server","version":"1.0.0"}' > samples/mcp-filesystem-server/package.json \
  && echo '{"name":"mcp-github-server","version":"1.0.0"}' > samples/mcp-github-server/package.json \
  && echo '{"name":"mcp-puppeteer-server","version":"1.0.0"}' > samples/mcp-puppeteer-server/package.json \
  && echo '{"name":"mcp-slack-server","version":"1.0.0"}' > samples/mcp-slack-server/package.json \
  && echo '{"name":"mcp-sqlite-server","version":"1.0.0"}' > samples/mcp-sqlite-server/package.json \
  && echo '{"name":"warden-sdk-python","version":"1.0.0"}' > packages/sdk-python/package.json \
  && echo '{"name":"warden-api-python","version":"1.0.0"}' > apps/api-python/package.json
RUN npm ci --ignore-scripts
COPY apps/web apps/web
COPY packages/shared packages/shared
RUN npm run build --workspace=@warden/shared && npm run build --workspace=@warden/web

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
