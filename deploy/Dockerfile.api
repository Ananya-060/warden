FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/cli/package.json apps/cli/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/sdk/package.json packages/sdk/package.json
RUN mkdir -p samples/mcp-filesystem-server samples/mcp-github-server samples/mcp-puppeteer-server samples/mcp-slack-server samples/mcp-sqlite-server \
  && echo '{"name":"mcp-filesystem-server","version":"1.0.0"}' > samples/mcp-filesystem-server/package.json \
  && echo '{"name":"mcp-github-server","version":"1.0.0"}' > samples/mcp-github-server/package.json \
  && echo '{"name":"mcp-puppeteer-server","version":"1.0.0"}' > samples/mcp-puppeteer-server/package.json \
  && echo '{"name":"mcp-slack-server","version":"1.0.0"}' > samples/mcp-slack-server/package.json \
  && echo '{"name":"mcp-sqlite-server","version":"1.0.0"}' > samples/mcp-sqlite-server/package.json
RUN npm ci --ignore-scripts
COPY apps/api apps/api
COPY packages/shared packages/shared
COPY samples samples
RUN npm run build --workspace=@warden/shared && npm run build --workspace=@warden/api

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV WARDEN_DB_PATH=/data/warden_db.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api ./apps/api
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/samples ./samples
RUN mkdir -p /data && chown -R node:node /data
USER node
EXPOSE 3000
CMD ["node", "apps/api/dist/server.js"]
