FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY apps/api/package.json apps/api/
COPY apps/cli/package.json apps/cli/
COPY apps/web/package.json apps/web/
COPY apps/api-python/package.json apps/api-python/
COPY packages/shared/package.json packages/shared/
COPY packages/sdk/package.json packages/sdk/
COPY packages/sdk-python/package.json packages/sdk-python/
RUN npm ci --ignore-scripts
COPY apps/web apps/web
COPY packages/shared packages/shared
RUN npm run build --workspace=@warden/shared && npm run build --workspace=@warden/web

FROM nginx:1.27-alpine
# Install envsubst (part of gettext)
RUN apk add --no-cache gettext
# Copy the nginx config template
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
# Copy built static files
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
# At startup: substitute ${API_URL} in the nginx template, then start nginx
CMD ["/bin/sh", "-c", "envsubst '${API_URL}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
